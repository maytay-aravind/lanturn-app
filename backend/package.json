{
  "name": "lanturn-backend",
  "version": "0.1.0",
  "private": true,
  "description": "LanTURN backend API (Node.js + Express + Firebase Admin)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node src/scripts/seed.js",
    "lint": "eslint .",
    "test": "node --test tests/"
  },
  "imports": {
    "#config": "./src/config/index.js",
    "#config/*": "./src/config/*",
    "#middlewares": "./src/middlewares/index.js",
    "#middlewares/*": "./src/middlewares/*",
    "#services/*": "./src/services/*",
    "#repositories/*": "./src/repositories/*",
    "#clients/*": "./src/clients/*",
    "#controllers/*": "./src/controllers/*",
    "#routes/*": "./src/routes/*",
    "#schemas/*": "./src/schemas/*",
    "#utils/*": "./src/utils/*",
    "#firebase": "./src/firebase/index.js",
    "#firebase/*": "./src/firebase/*",
    "#supabase": "./src/supabase/index.js",
    "#supabase/*": "./src/supabase/*"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "firebase-admin": "^12.4.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "pdf-parse": "^2.4.5",
    "pino": "^9.3.2",
    "pino-pretty": "^13.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^9.9.0",
    "firebase-tools": "^15.24.0"
  }
}
